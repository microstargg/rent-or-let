{
  "name": "rent-or-let-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:push": "npm run db:push -w @repo/database",
    "db:generate": "npm run db:generate -w @repo/database",
    "db:studio": "npm run db:studio -w @repo/database",
    "db:setup": "node scripts/setup-db.mjs",
    "prepare-tenant": "node scripts/prepare-tenant.mjs"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "dotenv": "^17.4.2",
    "turbo": "^2.5.4"
  }
}
