# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Neon Auth — enable in Neon Console → Auth, then copy Auth URL
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.eu-west-2.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-32-char-random-secret-from-openssl-rand-base64-32

# Public site
NEXT_PUBLIC_SITE_URL=https://www.rent-or-let.co.uk

# Vercel Blob (property images in production)
BLOB_READ_WRITE_TOKEN=

# Cron
CRON_SECRET=generate-a-random-secret

# Email (Resend)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_DOMAIN=
# Optional verified from-address, e.g. Property Management Services <info@rent-or-let.co.uk>
RESEND_FROM=

# AI (Vercel AI SDK)
# Start on Google's free AI Studio tier, then switch to AI Gateway / a paid model if needed.
# Get a key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model override. Google key path: gemini-3.6-flash (default), then gemini-3.5-flash / lite / flash-latest.
# Gateway path: google/gemini-3.7-flash (default when no Google key), then 3.6 / 3.5 Flash.
# Retired model ids are retried automatically; staff never see the provider error.
AI_MODEL=
# Paid / Vercel-hosted path (optional). On Vercel, OIDC can replace this key.
AI_GATEWAY_API_KEY=

# EPC Open Data Communities (https://epc.opendatacommunities.org)
EPC_API_EMAIL=
EPC_API_KEY=

# Stripe (renter portal payments — optional card rail)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Rightmove RTDF
# Base64-encode your .pem keystore: certutil -encode file.pem tmp.b64 && type tmp.b64 (Windows)
# or: base64 -i file.pem | tr -d '\n' (macOS/Linux)
RIGHTMOVE_NETWORK_ID=
RIGHTMOVE_BRANCH_ID=
RIGHTMOVE_CERT_PEM=
RIGHTMOVE_CERT_PASSWORD=
# Sandbox (during beta testing): https://adfapi.adftest.rightmove.com/v1/property/
# Production (default if unset): https://adfapi.rightmove.co.uk/v1/property/
RIGHTMOVE_RTDF_URL=

# OnTheMarket RTDF
OTM_NETWORK_ID=
OTM_BRANCH_ID=
OTM_CERT_PEM=
OTM_CERT_PASSWORD=
