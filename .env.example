# Database (Neon Postgres) — used as the fallback agency (AGENCY_SLUG / TENANT_ID)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Runtime agency. Host {slug}.letflow.app selects the agency; this is the local/CI fallback.
AGENCY_SLUG=pms
# TENANT_ID is still accepted as a fallback alias for AGENCY_SLUG
TENANT_ID=pms
# Optional explicit list (defaults to all registered agencies)
# AGENCY_SLUGS=pms,veri-properties
LETFLOW_ROOT_DOMAIN=letflow.app

# Neon Auth — enable in Neon Console → Auth, then copy Auth URL
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.eu-west-2.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-32-char-random-secret-from-openssl-rand-base64-32

# Local-only origins. Production derives https://{slug}.letflow.app from the Host header.
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Per-agency overrides (optional; fallback agency uses DATABASE_URL / NEON_AUTH_* above)
# AGENCY_PMS_DATABASE_URL=
# AGENCY_PMS_NEON_AUTH_BASE_URL=
# AGENCY_PMS_NEON_AUTH_COOKIE_SECRET=
# AGENCY_PMS_PUBLIC_SITE_URL=https://www.rent-or-let.co.uk
# AGENCY_PMS_WEBSITE_ENABLED=true
# AGENCY_PMS_PLATFORM_HOST=pms.letflow.app
# AGENCY_PMS_REVALIDATE_URL=https://www.rent-or-let.co.uk/api/revalidate
# AGENCY_PMS_REVALIDATE_SECRET=

# Vercel Blob (property images in production)
BLOB_READ_WRITE_TOKEN=

# Cron
CRON_SECRET=generate-a-random-secret

# Email (Resend)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_DOMAIN=
# Optional verified from-address, e.g. Property Management Services <info@rent-or-let.co.uk>
RESEND_FROM=

# AI (Vercel AI SDK)
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL=
AI_GATEWAY_API_KEY=

# EPC Open Data Communities (https://epc.opendatacommunities.org)
EPC_API_EMAIL=
EPC_API_KEY=

# Stripe (renter portal payments — optional card rail)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Rightmove RTDF
RIGHTMOVE_NETWORK_ID=
RIGHTMOVE_BRANCH_ID=
RIGHTMOVE_CERT_PEM=
RIGHTMOVE_CERT_PASSWORD=
RIGHTMOVE_RTDF_URL=

# OnTheMarket RTDF
OTM_NETWORK_ID=
OTM_BRANCH_ID=
OTM_CERT_PEM=
OTM_CERT_PASSWORD=
